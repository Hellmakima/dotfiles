#!/data/data/com.termux/files/usr/bin/bash
# gdserve - serve Google Drive over local SFTP for yazi (no FUSE needed)
set -e

REMOTE="gd:"
HOST="127.0.0.1"
PORT="2022"
ADDR="$HOST:$PORT"
USER="gd"
KEY="$HOME/.ssh/gdrive_sftp"
LOG="$PREFIX/tmp/gdserve.log"
PIDFILE="$PREFIX/tmp/gdserve.pid"

port_open() {
	if exec 9<>/dev/tcp/$HOST/$PORT 2>/dev/null; then
		exec 9<&-
		exec 9>&-
		return 0
	fi
	return 1
}

start() {
	if port_open; then
		echo "gdserve: already up on sftp://gd ($ADDR)"
		return 0
	fi
	pkill -x rclone 2>/dev/null || true
	sleep 1
	(
		setsid nohup rclone serve sftp "$REMOTE" \
			--addr "$ADDR" \
			--user "$USER" \
			--authorized-keys "$KEY.pub" \
			--vfs-cache-mode off \
			>>"$LOG" 2>&1 </dev/null &
	)
	for i in $(seq 1 45); do
		port_open && break
		sleep 1
	done
	if port_open; then
		echo "gdserve: up on sftp://gd ($ADDR)"
	else
		echo "gdserve: FAILED - check $LOG"
		cat "$LOG" | tail -5
		exit 1
	fi
}

stop() {
	pkill -x rclone 2>/dev/null || true
	rm -f "$PIDFILE"
	echo "gdserve: stopped"
}

case "${1:-start}" in
	start) start ;;
	stop) stop ;;
	restart) stop && start ;;
	status)
		if port_open; then
			echo "gdserve: running ($ADDR)"
		else
			echo "gdserve: not running"
		fi
		;;
	*) echo "usage: gdserve {start|stop|restart|status}" ;;
esac