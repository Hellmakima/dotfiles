#!/data/data/com.termux/files/usr/bin/bash
# qr - decode latest screenshot (or $1) and copy to clipboard
img="${1:-$(ls -t ~/storage/pictures/Screenshots/* 2>/dev/null | head -1)}"
if [ -z "$img" ]; then
  echo "no screenshot found"
  exit 1
fi
if [ ! -f "$img" ]; then
  echo "$img: not found"
  exit 1
fi
out=$(zbarimg -q "$img" 2>/dev/null | sed 's/^QR-Code://')
if [ -z "$out" ]; then
  echo "no qr found"
  exit 1
fi
echo "$out"
echo "$out" | termux-clipboard-set
