#!/data/data/com.termux/files/usr/bin/bash
# m3u8 - download an m3u8 stream, output defaults to <random digits>.mp4
url="$1"
if [ -z "$url" ]; then
  echo "usage: m3u8 <url> [out.mp4]"
  exit 1
fi
out="${2:-$(shuf -i 1000000000-9999999999 -n 1).mp4}"
ffmpeg \
  -reconnect 1 \
  -reconnect_streamed 1 \
  -reconnect_on_network_error 1 \
  -reconnect_on_http_error 4xx,5xx \
  -reconnect_max_retries 20 \
  -seg_max_retry 10 \
  -i "$url" \
  -c copy \
  "$out"
