  # Termux's 2.70 build segfaults (SIGSEGV) in the sixel/image logo path.
  # Official NDK build works:
  curl -LO https://github.com/fastfetch-cli/fastfetch/releases/download/2.70.0/fastfetch-android-aarch64.tar.gz
  tar xzf fastfetch-android-aarch64.tar.gz
  install -m755 fastfetch-android-aarch64/data/data/com.termux/files/usr/bin/fastfetch ~/dots/moto/bin/fastfetch
  .bashrc: alias ff="fastfetch --logo-type sixel --logo <img>"

GDrive in yazi (no FUSE):
  ssh-keygen -t ed25519 -f ~/.ssh/gdrive_sftp -N ""
  bin/gdserve      # start/stop/status local SFTP bridge on 127.0.0.1:2022 (auto-starts in .bashrc)
  yazi keymap g d  # cd sftp://gd  (vfs.toml registers host)
  vfs.toml has [sftp.gd] host=127.0.0.1 user=gd port=2022 key_file=~/.ssh/gdrive_sftp

