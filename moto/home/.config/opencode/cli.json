{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "auto"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "hide"
  },
  "animations": true,
  "tabs": {
    "mode": "auto",
    "scope": "cwd",
    "layout": "horizontal"
  },
  "scroll": {
    "speed": 1,
    "acceleration": true
  },
  "prompt": {
    "image_preview": true
  },
  "terminal": {
    "title": false
  }
}
